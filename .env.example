# Anthropic API key used by HandyBot during development.
#
# IMPORTANT: because Expo `EXPO_PUBLIC_*` env vars are bundled into the
# client app, this key will ship inside the JavaScript bundle. That is
# ONLY acceptable for local development. For a real production release
# you must proxy Claude calls through your own backend and never ship an
# API key in the mobile bundle.
#
# Get a key at https://console.anthropic.com/
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...
