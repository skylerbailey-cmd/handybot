# Supabase project for cloud backup, auth, and Claude proxy.
# Found at: Supabase dashboard → Project Settings → API.
# The anon/publishable key is safe to ship in the client; Row Level Security
# policies on the database enforce who can read/write what.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# The Anthropic API key is NOT shipped in the client bundle.
# It lives server-side as a Supabase Edge Function secret:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# All Claude calls are proxied through the claude-proxy Edge Function.
