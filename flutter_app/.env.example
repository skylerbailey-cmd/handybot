# Anthropic API key used by HandyBot during development.
#
# IMPORTANT: This key will ship inside the Flutter app bundle when passed via
# --dart-define. That is only acceptable for local development. For a real
# production release, proxy Claude calls through your own backend and never
# ship an API key in the mobile bundle.
#
# Get a key at https://console.anthropic.com/
# Pass at build time:  flutter run --dart-define=ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project for cloud backup / multi-device sync (paid tier only).
# Row Level Security on the database enforces who can read/write what — the
# publishable anon key is safe to ship in the client.
#
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
